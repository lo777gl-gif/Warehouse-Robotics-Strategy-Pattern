@startuml
hide empty members
skinparam classAttributeIconSize 0

interface RobotStrategy {
  +choose(freeRobots, target): Optional<Robot>
  +name(): String
}
class NearestRobot
class MostChargedRobot
class LongestIdleRobot
class RobotAssigner {
  -strategy: RobotStrategy
  +setStrategy(strategy)
  +assign(freeRobots, target)
}
RobotStrategy <|.. NearestRobot
RobotStrategy <|.. MostChargedRobot
RobotStrategy <|.. LongestIdleRobot
RobotAssigner o--> RobotStrategy

interface OrderStrategy {
  +arrange(orders): List<Order>
  +name(): String
}
class ArrivalOrder
class SmallestFirst
class SameShelfTogether
class OrderPlanner {
  -strategy: OrderStrategy
  +setStrategy(strategy)
  +plan(orders)
}
OrderStrategy <|.. ArrivalOrder
OrderStrategy <|.. SmallestFirst
OrderStrategy <|.. SameShelfTogether
OrderPlanner o--> OrderStrategy

interface BatterySensor {
  +batteryLevel(robotId): int
}
class SimulatedBatterySensor
BatterySensor <|.. SimulatedBatterySensor
MostChargedRobot --> BatterySensor

class Situation {
  hour
  queueSize
}
class StrategySelector {
  +robotStrategyFor(situation): RobotStrategy
  +orderStrategyFor(situation): OrderStrategy
}
StrategySelector ..> Situation
StrategySelector ..> RobotStrategy : creates
StrategySelector ..> OrderStrategy : creates
StrategySelector --> BatterySensor

class Main
Main ..> RobotAssigner
Main ..> OrderPlanner
Main ..> StrategySelector
@enduml
